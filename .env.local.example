# Supabase — found in Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your production URL — used for SEO metadata, Open Graph tags, and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://dateagepro.com

# Google Analytics 4 Measurement ID — found in GA4 > Admin > Data Streams
# Format: G-XXXXXXXXXX. Leave unset to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
